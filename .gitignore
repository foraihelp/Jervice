venv/
.env
data/
__pycache__/
*.pyc
# Generated per-machine at window-open time (see jarvis/ui/window.py's _html_with_look) --
# only ever appears here at all when running unpackaged with the default PROJECT_ROOT.
ui_cache/

# PyInstaller build output (regenerate with build_exe.bat) and the
# installer's compiled output (regenerate with installer/jarvis.iss) --
# both are large, regenerable binaries that don't belong in source control.
build/
dist/
*.spec
installer/output/
# Fetched at build time (see installer/README.md) rather than committed.
installer/MicrosoftEdgeWebview2Setup.exe
