# Copy this file to ".env" and fill in your real key(s). Easiest way to
# set these is actually the app's own Settings window (gear icon) once
# it's running -- it writes here for you. Only the key matching
# config.yaml's brain.provider needs to be real; the other can stay blank.

# Used when config.yaml's brain.provider is "anthropic" (the default).
# Get a key at https://console.anthropic.com/ (Settings -> API Keys).
# You will need billing enabled on the account for API calls to work.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Used when config.yaml's brain.provider is "openai" -- this also covers
# any OpenAI-compatible endpoint (see brain.base_url in config.yaml), so
# put that provider's key here too if you're using e.g. Groq or OpenRouter.
# Get an OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Shared secret the iOS app (or any other remote client) must send as
# "Authorization: Bearer <this value>" to use the /chat API. Make up any
# long random string -- it doesn't need to mean anything, e.g. run
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` to generate one.
JARVIS_API_TOKEN=change-me-to-a-long-random-string
